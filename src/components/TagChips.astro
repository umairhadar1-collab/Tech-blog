---
interface Props { tags: string[]; current?: string }
const { tags, current } = Astro.props;
---
<nav class="chips" aria-label="Filter by topic">
  <a class="chip" href="/" aria-current={current === undefined ? 'page' : undefined}>all</a>
  {tags.map((t) => <a class="chip" href={`/tags/${t}/`} aria-current={current === t ? 'page' : undefined}>{t}</a>)}
</nav>
