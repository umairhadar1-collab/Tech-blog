---
import Base from '../../layouts/Base.astro';
import { getPosts, allTags } from '../../lib/posts';
const posts = await getPosts();
const tags = allTags(posts);
const count = (t: string) => posts.filter((p) => p.data.tags.includes(t)).length;
---
<Base title="Topics" description="Browse every Stack Notes post by topic.">
  <section class="hero">
    <p class="eyebrow">Topics</p>
    <h1>Browse by topic</h1>
  </section>
  <nav class="chips" aria-label="All topics">
    {tags.map((t) => <a class="chip" href={`/tags/${t}/`}>{t} · {count(t)}</a>)}
  </nav>
</Base>
